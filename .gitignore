.DS_Store

# `dist/` is NOT ignored, deliberately. It is not a local build output — it is
# the file a `<script src>` consumer loads, and the reason this package can be
# used with no toolchain at all. `scripts/build.js` regenerates it from `src/`
# and `test/editor.test.js` evaluates it, so a stale one cannot pass CI.

# An intermediate for docs/og.png, regenerated by scripts/landing-assets.js.
# Only the PNG is served; a stray og.html on the site is just a confusing URL.
docs/og.html

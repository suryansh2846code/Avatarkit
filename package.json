  "bugs": {
    "url": "https://github.com/suryansh2846code/character/issues"
  },
  "keywords": [
    "avatar",
    "svg",
    "3d",
    "identicon",
    "character",
    "editor",
    "follow-cursor",
    "profile-picture",
    "generative",
    "zero-dependency"
  ],
  "type": "module",
